<odoo>
  <record id="inspection_user_rule" model="ir.rule"><field name="name">设备检查：本人任务</field><field name="model_id" ref="quality_control_oca.model_qc_inspection"/><field name="domain_force">['|',('equipment_id','=',False),('user','=',user.id)]</field><field name="groups" eval="[(4,ref('group_user'))]"/></record>
  <record id="inspection_manager_rule" model="ir.rule"><field name="name">设备检查：主管</field><field name="model_id" ref="quality_control_oca.model_qc_inspection"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4,ref('group_manager'))]"/></record>
  <record id="line_company_rule" model="ir.rule"><field name="name">检查结果：公司</field><field name="model_id" ref="quality_control_oca.model_qc_inspection_line"/><field name="domain_force">[('inspection_id.company_id','in',company_ids + [False])]</field></record>
  <record id="line_user_rule" model="ir.rule"><field name="name">设备检查结果：本人任务</field><field name="model_id" ref="quality_control_oca.model_qc_inspection_line"/><field name="domain_force">['|',('inspection_id.equipment_id','=',False),('inspection_id.user','=',user.id)]</field><field name="groups" eval="[(4,ref('group_user'))]"/></record>
  <record id="line_manager_rule" model="ir.rule"><field name="name">设备检查结果：主管</field><field name="model_id" ref="quality_control_oca.model_qc_inspection_line"/><field name="domain_force">[(1,'=',1)]</field><field name="groups" eval="[(4,ref('group_manager'))]"/></record>
  <record id="question_company_rule" model="ir.rule"><field name="name">检查标准项目：公司</field><field name="model_id" ref="quality_control_oca.model_qc_test_question"/><field name="domain_force">[('test.company_id','in',company_ids + [False])]</field></record>
  <record id="answer_company_rule" model="ir.rule"><field name="name">检查标准选项：公司</field><field name="model_id" ref="quality_control_oca.model_qc_test_question_value"/><field name="domain_force">[('test_line.test.company_id','in',company_ids + [False])]</field></record>
  <record id="equipment_user_rule" model="ir.rule"><field name="name">设备检查：可读本人任务设备</field><field name="model_id" ref="maintenance.model_maintenance_equipment"/><field name="domain_force">[('inspection_ids.user','=',user.id)]</field><field name="groups" eval="[(4,ref('group_user'))]"/></record>
</odoo>
