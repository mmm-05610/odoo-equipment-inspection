odoo.maomaokingdom.top {
    encode zstd gzip
    @private_api path /web/database /web/database/* /xmlrpc /xmlrpc/* /jsonrpc /jsonrpc/*
    handle @private_api {
        respond "Not found" 404
    }
    handle / {
        redir /demo 302
    }
    handle /demo* {
        reverse_proxy 172.17.0.1:8092
    }
    handle {
        reverse_proxy 172.17.0.1:8076
    }
}
