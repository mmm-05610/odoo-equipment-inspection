<odoo>
  <record id="privilege_inspection" model="res.groups.privilege"><field name="name">设备检查</field><field name="category_id" ref="base.module_category_supply_chain"/></record>
  <record id="group_user" model="res.groups"><field name="name">检查员</field><field name="privilege_id" ref="privilege_inspection"/><field name="implied_ids" eval="[(4,ref('base.group_user')),(4,ref('quality_control_oca.group_quality_control_user'))]"/></record>
  <record id="group_manager" model="res.groups"><field name="name">检查主管</field><field name="privilege_id" ref="privilege_inspection"/><field name="implied_ids" eval="[(4,ref('group_user')),(4,ref('quality_control_oca.group_quality_control_manager')),(4,ref('maintenance.group_equipment_manager'))]"/><field name="user_ids" eval="[(4,ref('base.user_admin')),(4,ref('base.user_root'))]"/></record>
</odoo>
